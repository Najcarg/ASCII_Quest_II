        slotCtrl.Caption = ""
        slotCtrl.Tag = ""
        slotCtrl.ControlTipText = ""
        slotCtrl.BackColor = vbBlack
        slotCtrl.ForeColor = vbWhite
        slotCtrl.BorderColor = RGB(90, 90, 90)
    Next i

    ' Load up to 40 inventory items for current character
    sql = "SELECT TOP 40 inv.ItemInstanceID, inst.GeneratedName, inst.BaseItemID, inst.RarityID, r.RarityName " & _
          "FROM (tblInventory AS inv " & _
          "INNER JOIN tblItemInstances AS inst ON inv.ItemInstanceID = inst.ItemInstanceID) " & _
          "LEFT JOIN tblRarities AS r ON inst.RarityID = r.RarityID " & _
          "WHERE inv.CharacterID=" & CLng(gCharID) & " " & _
          "ORDER BY inv.InventoryID;"

    Set rs = CurrentDb.OpenRecordset(sql, dbOpenSnapshot)

    i = 1
    Do While Not rs.EOF And i <= 40
        itemID = CLng(Nz(rs!itemInstanceID, 0))
        rarityID = CLng(Nz(rs!rarityID, 1))

        glyph = GetItemGlyphSafe(CLng(Nz(rs!baseItemID, 0)), Nz(rs!generatedName, ""))
