Private Sub txtMapView_MouseUp(Button As Integer, Shift As Integer, x As Single, y As Single)
    Dim pos As Long
    Dim charsPerRow As Long
    Dim row As Long
    Dim col As Long

    If MaxX < 0 Or MaxY < 0 Then Exit Sub
    If Len(Me.txtMapView & "") = 0 Then Exit Sub

    pos = Me.txtMapView.SelStart
    charsPerRow = (MaxX + 1) + 2

    row = pos \ charsPerRow
    col = pos Mod charsPerRow
    If col > MaxX Then col = MaxX

    If row < 0 Or row > MaxY Then Exit Sub
    If col < 0 Or col > MaxX Then Exit Sub

    ' --- MODE SWITCH ---
    Select Case Nz(Me.optMode.Value, 1)

        Case 1  ' Tiles (your existing behavior)
            Me.txtX = col
            Me.txtY = row
            If Button = 2 Then
                ApplyTileAtCoordinates True
            Else
                ApplyTileAtCoordinates False
            End If

        Case 2  ' Links (NEW behavior)
            FillLinkCoordinates col, row

        Case 3  ' Spawns (your spawn behavior)
            If Button = 2 Then
                PlaceSpawnAt col, row, True
            Else
                PlaceSpawnAt col, row, False
            End If
            DrawMapPreview
    End Select
End Sub

