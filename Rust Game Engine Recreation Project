End Sub

Private Sub HandleMonsterRespawns(ByVal locID As Long)
    Dim db As DAO.Database
    Dim sql As String

    Set db = CurrentDb

    sql = "UPDATE tblMonsterInstances AS MI " & _
          "INNER JOIN tblMonsters AS M ON MI.MonsterID = M.MonsterID " & _
          "SET MI.IsAlive=True, MI.CurrentMHP=M.MMaxHP, MI.RespawnAt=Null " & _
          "WHERE MI.LocationID=" & CLng(locID) & _
          "  AND MI.CharacterID=" & CLng(gCharID) & _
          "  AND MI.IsAlive=False " & _
          "  AND MI.RespawnAt Is Not Null " & _
          "  AND MI.RespawnAt<=Now() " & _
          "  AND M.MRespawnSeconds>0;"

    db.Execute sql, dbFailOnError
End Sub

Private Function GetMonsterIndexAt(ByVal x As Long, ByVal y As Long) As Long
    Dim i As Long
    If MonsterCount = 0 Then GetMonsterIndexAt = -1: Exit Function

    For i = 0 To MonsterCount - 1
        If MonsterX(i) = x And MonsterY(i) = y Then
            GetMonsterIndexAt = i
            Exit Function
        End If
    Next i

    GetMonsterIndexAt = -1
End Function

Private Function IsMonsterAt(ByVal x As Long, ByVal y As Long) As Boolean
    Dim idx As Long
    idx = GetMonsterIndexAt(x, y)
    If idx < 0 Then
        IsMonsterAt = False
    Else
        IsMonsterAt = (MonsterAlive(idx) And MonsterHP(idx) > 0)
    End If
End Function


