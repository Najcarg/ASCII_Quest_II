        ' gCritChance = gCritChance + NzL(rs!TotalCritChance, 0)
        ' gCritDamage = gCritDamage + NzL(rs!TotalCritDamage, 0)
        ' etc...

        rs.MoveNext
    Loop
    rs.Close

    If gAttackCount < 1 Then gAttackCount = 1
    If gMaxHP < 1 Then gMaxHP = 1
End Sub

