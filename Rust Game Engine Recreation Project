    gMaxHP = NzL(rs!baseHP, 1) + (lvl - 1) * NzL(rs!HPPerLevel, 0)
    gMaxMana = NzL(rs!baseMana, 0) + (lvl - 1) * NzL(rs!ManaPerLevel, 0)
    gAtk = NzL(rs!BaseAttack, 0) + (lvl - 1) * NzL(rs!AttackPerLevel, 0)
    gDef = NzL(rs!BaseDefense, 0) + (lvl - 1) * NzL(rs!DefensePerLevel, 0)
