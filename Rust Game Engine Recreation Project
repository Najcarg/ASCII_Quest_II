    Dim sql As String

    Set db = CurrentDb

    sql = "INSERT INTO tblMonsterInstances " & _
          "(MonsterID, LocationID, CharacterID, MPosX, MPosY, CurrentMHP, CurrentMMana, CurrentMAttack, CurrentMDefense, IsAlive, RespawnAt, GoldRewardLog) " & _
          "SELECT S.MonsterID, S.LocationID, " & CLng(gCharID) & " AS CharacterID, " & _
          "S.MPosX, S.MPosY, M.MMaxHP, M.MMaxMana, M.MAttack, M.MDefense, True, Null, 0 " & _
          "FROM tblMonsterSpawns AS S " & _
          "INNER JOIN tblMonsters AS M ON S.MonsterID = M.MonsterID " & _
          "WHERE S.LocationID=" & CLng(locID) & " " & _
          "AND NOT EXISTS (" & _
          "    SELECT 1 FROM tblMonsterInstances AS I " & _
          "    WHERE I.CharacterID=" & CLng(gCharID) & _
