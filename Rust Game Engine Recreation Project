Private Function GetItemGlyphSafe(ByVal baseItemID As Long, ByVal generatedName As String) As String
    Dim v As Variant

    On Error Resume Next
    v = DLookup("Glyph", "tblBaseItems", "BaseItemID=" & CLng(baseItemID))
    On Error GoTo 0

    If Not IsNull(v) And Len(Nz(v, "")) > 0 Then
        GetItemGlyphSafe = Left$(CStr(v), 1)
    ElseIf Len(generatedName) > 0 Then
        GetItemGlyphSafe = Left$(generatedName, 1)
    Else
        GetItemGlyphSafe = "?"
    End If
End Function

