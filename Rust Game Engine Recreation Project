Private Sub ApplyEquipmentStats()
    ' This adds bonuses from equipped items.
    '
    ' Recommended table (simple and clean):
    '   tblEquipment(CharacterID Number, Slot ShortText, ItemInstanceID Number)
    '
    ' If you don't have tblEquipment yet, this sub just does nothing.

    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim sql As String

    Set db = CurrentDb

    If Not TableExists("tblEquipment") Then Exit Sub
    If gCharID = 0 Then Exit Sub

    sql = "SELECT II.* " & _
          "FROM tblEquipment AS E " & _
          "INNER JOIN tblItemInstances AS II ON E.ItemInstanceID = II.ItemInstanceID " & _
          "WHERE E.CharacterID=" & CLng(gCharID) & ";"

    Set rs = db.OpenRecordset(sql, dbOpenSnapshot)
    Do While Not rs.EOF
        ' These columns exist in your tblItemInstances screenshot:
        gAtk = gAtk + NzL(rs!totalAtk, 0)
        gDef = gDef + NzL(rs!totalDef, 0)
        gMaxHP = gMaxHP + NzL(rs!totalHP, 0)
        gMaxMana = gMaxMana + NzL(rs!totalMana, 0)

