    lvl = IIf(gLevel < 1, 1, gLevel)

    sql = "SELECT * FROM tblClasses WHERE ClassID=" & CLng(gClassID) & ";"
    Set rs = CurrentDb.OpenRecordset(sql, dbOpenSnapshot)
    If rs.EOF Then
