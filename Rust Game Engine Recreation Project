Public Sub AddFieldsToTable(ByVal tableName As String, ByVal fields As Variant, Optional ByVal batchSize As Long = 10)
    Dim db As DAO.Database
    Dim ws As DAO.Workspace
    Dim i As Long, inBatch As Long
    Dim fName As String, fType As String
    Dim sql As String
    Dim startedTrans As Boolean

    Set db = CurrentDb
    Set ws = DBEngine.Workspaces(0)

    On Error GoTo EH
    ws.BeginTrans
    startedTrans = True

    For i = LBound(fields) To UBound(fields)
        fName = CStr(fields(i)(0))
        fType = CStr(fields(i)(1))

        If Not FieldExists(tableName, fName) Then
            sql = "ALTER TABLE [" & tableName & "] ADD COLUMN [" & fName & "] " & fType & ";"
            db.Execute sql, dbFailOnError

            ' IMPORTANT after ALTER TABLE
            db.TableDefs.Refresh
        End If

        inBatch = inBatch + 1
        If batchSize > 0 And inBatch >= batchSize Then
            ws.CommitTrans
            ws.BeginTrans
            inBatch = 0
        End If
    Next i

    ws.CommitTrans
    Exit Sub

EH:
    If startedTrans Then
        On Error Resume Next
        ws.Rollback
        On Error GoTo 0
    End If
    MsgBox "Schema update failed: " & Err.Number & " - " & Err.Description, vbCritical
