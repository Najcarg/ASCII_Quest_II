    sql = "DELETE FROM tblLocationLinks " & _
          "WHERE [FromLocationID]=" & locID & _
          " AND [FromX]=" & CLng(x) & _
          " AND [FromY]=" & CLng(y) & ";"
    db.Execute sql, dbFailOnError

    ' Insert new
    sql = "INSERT INTO tblLocationLinks " & _
          "([FromLocationID],[FromX],[FromY],[ToLocationID],[ToX],[ToY],[LinkType]) " & _
          "VALUES (" & locID & "," & CLng(x) & "," & CLng(y) & "," & _
