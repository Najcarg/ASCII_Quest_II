Public Sub LoadCurrentCharacterStats(Optional ByVal CharacterID As Long = 0, Optional ByVal DoRecalc As Boolean = True)
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim sql As String
    Dim locJoinExpr As String

    If CharacterID <> 0 Then gCharID = CLng(CharacterID)
    If gCharID = 0 Then Exit Sub

    Set db = CurrentDb

    ' Join Locations by CurrentMapID if it exists, else LocationID
    locJoinExpr = "IIf(Nz(C.[CurrentMapID],0)<>0, C.[CurrentMapID], C.[LocationID])"

    sql = "SELECT C.*, " & _
          "Nz(L.[Name],'') AS LocName, " & _
          "Nz(K.[ClassName],'') AS ClassNameText " & _
          "FROM (tblCharacters AS C " & _
          "LEFT JOIN tblLocations AS L ON L.[LocationID]=" & locJoinExpr & ") " & _
          "LEFT JOIN tblClasses AS K ON C.[ClassID]=K.[ClassID] " & _
          "WHERE C.[CharacterID]=" & CLng(gCharID) & ";"

    Set rs = db.OpenRecordset(sql, dbOpenSnapshot)
    If rs.EOF Then
        rs.Close
        Exit Sub
    End If

    ' Identity
    gCharName = Nz(rs!CharacterName, "")
    gClassID = NzL(rs!ClassID, 0)
    gClassName = Nz(rs!ClassNameText, "")
    gPlayerGlyph = Nz(rs!Class, "@")   ' your glyph field is tblCharacters.Class

    ' Location / position (prefer CurrentMapID when present)
    On Error Resume Next
    If Nz(rs!CurrentMapID, 0) <> 0 Then
        gLocationID = NzL(rs!CurrentMapID, 1)
    Else
        gLocationID = NzL(rs!LocationID, 1)
    End If
    On Error GoTo 0

    gLocationName = Nz(rs!LocName, "")
    gPosX = NzL(rs!PosX, 2)
    gPosY = NzL(rs!PosY, 2)

    ' Progress
    gLevel = NzL(rs!Level, 1)
    gXP = NzC(rs!Experience, 0)
    gGold = NzC(rs!Gold, 0)

    ' Current resources (we keep these)
    gHP = NzL(rs![CurrentHP], 1)
    gMana = NzL(rs![Mana], 0)

    rs.Close

    ' Recalculate derived stats (MaxHP, Attack, etc.)
    If DoRecalc Then
        RecalculateDerivedStats True   ' True = write derived stats back to tblCharacters
    Else
        ClampResources
    End If
End Sub



