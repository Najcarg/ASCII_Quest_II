Private Sub ApplyTileAtCoordinates(ByVal clearOnly As Boolean)
    Dim locID As Long
    Dim x As Long, y As Long
    Dim db As DAO.Database
    Dim rs As DAO.Recordset
    Dim crit As String
    Dim tileTypeID As Long
    Dim tileChar As String
    Dim tileName As String
    Dim walkable As Variant

    If IsNull(Me.cboLocation) Then
        MsgBox "Select a location first.", vbExclamation
        Exit Sub
    End If

    If IsNull(Me.txtX) Or IsNull(Me.txtY) Then
        MsgBox "Enter X and Y coordinates.", vbExclamation
        Exit Sub
    End If

    x = CLng(Me.txtX)
    y = CLng(Me.txtY)

    ' Bounds
    If x < 0 Or x > MaxX Or y < 0 Or y > MaxY Then
        MsgBox "Coordinates out of map bounds.", vbExclamation
        Exit Sub
    End If

    locID = Me.cboLocation.Value
    Set db = CurrentDb

    crit = "LocationID=" & locID & " AND X=" & x & " AND Y=" & y

    If clearOnly Then
        ' Delete tile row so it becomes default floor
        db.Execute "DELETE FROM tblMapTiles WHERE " & crit, dbFailOnError
        MapChars(x, y) = "."
        DrawMapPreview
        Exit Sub
    End If

    ' We are setting a tile: ensure a tile type is selected
    If IsNull(Me.cboTileType) Then
        MsgBox "Select a tile type.", vbExclamation
        Exit Sub
    End If

    tileTypeID = Me.cboTileType.Value

    ' Look up TileChar, TileName, Walkable from tblTileTypes
    tileChar = Nz(DLookup("TileChar", "tblTileTypes", "TileTypeID=" & tileTypeID), ".")
    tileName = Nz(DLookup("TileName", "tblTileTypes", "TileTypeID=" & tileTypeID), "")
    walkable = DLookup("Walkable", "tblTileTypes", "TileTypeID=" & tileTypeID)

    ' Upsert into tblMapTiles:
    ' if a row exists for this (LocationID,X,Y), update it; otherwise, add new
    Set rs = db.OpenRecordset("SELECT * FROM tblMapTiles WHERE " & crit, dbOpenDynaset)

    If rs.EOF Then
        rs.AddNew
        rs!LocationID = locID
        rs!x = x
        rs!y = y
    Else
        rs.Edit
    End If

    rs!tileChar = tileChar
    rs!walkable = IIf(IsNull(walkable), True, CBool(walkable))
    rs!TileType = tileName
    rs.Update
    rs.Close

    ' Update the array and redraw
    MapChars(x, y) = tileChar
    DrawMapPreview
End Sub


