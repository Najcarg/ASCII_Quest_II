Private Sub InitLocation(ByVal locID As Long)
    Dim db As DAO.Database
    Dim rsLoc As DAO.Recordset
    Dim rsTiles As DAO.Recordset
    Dim x As Long, y As Long
    Dim tType As String

    Set db = CurrentDb

    Set rsLoc = db.OpenRecordset( _
        "SELECT Width, Height FROM tblLocations WHERE LocationID=" & CLng(locID) & ";", dbOpenSnapshot)

    If rsLoc.EOF Then
        MsgBox "LocationID " & locID & " not found.", vbCritical
        rsLoc.Close
        Exit Sub
    End If

    MaxX = CLng(rsLoc!Width) - 1
    MaxY = CLng(rsLoc!height) - 1
    rsLoc.Close

    ReDim MapChars(0 To MaxX, 0 To MaxY)
    ReDim MapWalkable(0 To MaxX, 0 To MaxY)

    ' Default floor
    For y = 0 To MaxY
        For x = 0 To MaxX
            MapChars(x, y) = "."
            MapWalkable(x, y) = True
        Next x
    Next y

    ' Load tiles
    Set rsTiles = db.OpenRecordset( _
        "SELECT X, Y, TileChar, Walkable, TileType FROM tblMapTiles WHERE LocationID=" & CLng(locID) & ";", dbOpenSnapshot)

    Do While Not rsTiles.EOF
        x = CLng(rsTiles!x)
        y = CLng(rsTiles!y)

        If x >= 0 And x <= MaxX And y >= 0 And y <= MaxY Then
            MapChars(x, y) = Nz(rsTiles!tileChar, ".")
            MapWalkable(x, y) = Nz(rsTiles!walkable, True)

            tType = Nz(rsTiles!TileType, "")

            ' If you want Start tile to override player spawn:
            If tType = "Start" Then
                gPosX = x
                gPosY = y
                SaveCurrentCharacterPositionOnly
            ElseIf tType = "Exit" Then
                ExitTileX = x
                ExitTileY = y
            End If
        End If

        rsTiles.MoveNext
    Loop

    rsTiles.Close
End Sub




