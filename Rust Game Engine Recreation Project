Private Sub LoadLocationMap()
    Dim db As DAO.Database
    Dim rsLoc As DAO.Recordset
    Dim rsTiles As DAO.Recordset
    Dim locID As Long
    Dim x As Long, y As Long

    If IsNull(Me.cboLocation) Then
        Me.txtMapView = "(Select a location first)"
        Exit Sub
    End If

    locID = Me.cboLocation.Value
    Set db = CurrentDb

    ' 1) Get size from tblLocations
    Set rsLoc = db.OpenRecordset( _
        "SELECT Width, Height FROM tblLocations WHERE LocationID = " & locID)

    If rsLoc.EOF Then
        Me.txtMapView = "(Location not found)"
        Exit Sub
    End If

    MaxX = rsLoc!Width - 1
    MaxY = rsLoc!height - 1
    rsLoc.Close

    ' 2) Dimension array
    ReDim MapChars(0 To MaxX, 0 To MaxY)

    ' Default to floor (.) visually
    For y = 0 To MaxY
        For x = 0 To MaxX
            MapChars(x, y) = "."
        Next x
    Next y

    ' 3) Load tiles from tblMapTiles for this location
    Set rsTiles = db.OpenRecordset( _
        "SELECT X, Y, TileChar FROM tblMapTiles WHERE LocationID = " & locID)

    Do While Not rsTiles.EOF
        x = rsTiles!x
        y = rsTiles!y

        If x >= 0 And x <= MaxX And y >= 0 And y <= MaxY Then
            MapChars(x, y) = Nz(rsTiles!tileChar, ".")
        End If

        rsTiles.MoveNext
    Loop
    rsTiles.Close

    ' 4) Draw the map into txtMapView
    DrawMapPreview
End Sub

Private Sub DrawMapPreview()
    Dim x As Long, y As Long
    Dim line As String
    Dim outputText As String
    Dim locID As Long
    Dim ch As String

    outputText = ""

    ' Must have a selected location
    If IsNull(Me.cboLocation) Then
        Me.txtMapView = "(Select a location first)"
        Exit Sub
    End If
    locID = CLng(Me.cboLocation.Value)

    ' If map not loaded/dimensioned, load it first (this calls DrawMapPreview again)
    On Error GoTo ReloadMap
    ch = MapChars(0, 0)          ' quick test access
    On Error GoTo 0

    ' Draw
    For y = 0 To MaxY
        line = ""
        For x = 0 To MaxX

            ch = MapChars(x, y)

            ' Overlay markers
            If HasLinkAt(locID, x, y) Then
                ch = "D"          ' door/link marker
            ElseIf HasSpawnAt(locID, x, y) Then
                ch = "!"          ' spawn marker
            End If

            line = line & ch
        Next x
        outputText = outputText & line & vbCrLf
    Next y

    Me.txtMapView = outputText
    Exit Sub

ReloadMap:
    ' If MapChars not ready, reload location map and stop
    On Error GoTo 0
    LoadLocationMap
End Sub

